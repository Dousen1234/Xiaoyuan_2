# 构建产物
/build/

# 运行日志与输出（record 目录含 CSV 与绘图图片，log 为 colcon 日志）
/record/
/log/
*.csv

# 鲲弘 Linux SDK 参考仓库（可选克隆，不入库）
/.kunhong_sdk/

# 鲲弘 CANFD 模块官方配套资料（设备文档，不入库）
/KH-UCANFDXn-Mini 系列多路CANFD扩展模块配套资料/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# 编译缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.o
*.a
__pycache__/

# 厂家调试资料压缩包（体积过大，不入库）
/MPT调试资料.zip

# 离线依赖包（体积大且与架构相关，不入库）
/deploy/offline-debs/*.deb

# 厂商 CAN 驱动二进制（与内核版本强绑定，不入库）
/deploy/kcan-driver/*.ko
